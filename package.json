{
  "name": "zips-book",
  "version": "1.0.0",
  "description": "ZIPS-Book Enterprise ERP & Billing System",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "electron:dev": "concurrently -k -s first \"next dev\" \"electron .\"",
    "electron:start": "electron .",
    "electron:build": "bun run build && node scripts/prepare-standalone.cjs && electron-builder --win",
    "lint": "eslint && echo \"✓ Lint passed\"",
    "lint:check": "next typegen && tsc --noEmit && echo \"✓ Type check passed\" && eslint && echo \"✓ Lint passed\"",
    "migrate": "prisma migrate dev && prisma generate",
    "studio": "prisma studio --browser none",
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-toastify": "^11.1.0",
    "shadcn": "^4.20.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=20.x.x",
    "npm": ">=10.x.x"
  },
  "author": "Tamal Roy Chowdhury",
  "license": "UNLICENSED",
  "homepage": "https://github.com/tamaladvanceforging-boop/zips-book",
  "build": {
    "appId": "com.zipsbook.erp",
    "productName": "ZIPS-Book Enterprise ERP",
    "copyright": "Copyright © 2026 Tamal Roy Chowdhury. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "public/**/*",
      "prisma/dev.db"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZIPS-Book ERP"
    }
  }
}
